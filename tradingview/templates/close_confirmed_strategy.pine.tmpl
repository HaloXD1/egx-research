// Generated by egx-research: {{ strategy_id }} v{{ version }}
//@version=6
strategy("{{ strategy_title }}", overlay = true, pyramiding = 0, process_orders_on_close = false)

fastLength = input.int({{ fast_length }}, "Fast SMA", minval = 1)
slowLength = input.int({{ slow_length }}, "Slow SMA", minval = 2)
fast = ta.sma(close, fastLength)
slow = ta.sma(close, slowLength)
buySignal = ta.crossover(fast, slow) and barstate.isconfirmed
sellSignal = ta.crossunder(fast, slow) and barstate.isconfirmed

if buySignal
    strategy.entry("Long", strategy.long)
if sellSignal
    strategy.close("Long")

plot(fast, "Fast SMA", color = color.green)
plot(slow, "Slow SMA", color = color.orange)
plot(buySignal ? 1 : sellSignal ? -1 : 0, "egx_signal_code", display = display.data_window)
plot(buySignal ? 1 : sellSignal ? 0 : 0, "egx_target_exposure", display = display.data_window)
alertcondition(buySignal, "Buy", "{{ strategy_id }} buy signal")
alertcondition(sellSignal, "Sell", "{{ strategy_id }} sell signal")
