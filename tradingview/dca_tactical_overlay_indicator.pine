// EGX30 ETF DCA Core + Tactical Sleeve Indicator
//@version=6
indicator("EGX30 ETF DCA Core + Tactical Sleeve Indicator", overlay = true, max_labels_count = 500)

coreWeightPct = input.float(80.0, "Core DCA Weight %", minval = 0, maxval = 100, step = 1)
kamaLen = input.int(35, "KAMA Length", minval = 2)
kamaFast = input.int(5, "KAMA Fast", minval = 1)
kamaSlow = input.int(51, "KAMA Slow", minval = 2)
cciLen = input.int(38, "CCI Length", minval = 2)
cciThreshold = input.float(20.0, "CCI Threshold", step = 1)
sleeveStrongPct = input.float(100.0, "Sleeve Strong %", minval = 0, maxval = 100, step = 1)
sleeveNeutralPct = input.float(60.0, "Sleeve Neutral %", minval = 0, maxval = 100, step = 1)
sleeveBadPct = input.float(20.0, "Sleeve Defensive %", minval = 0, maxval = 100, step = 1)
atrLen = input.int(7, "ATR Length", minval = 1)
atrStopMult = input.float(4.4, "ATR Stop Mult", minval = 0.1, step = 0.1)
atrTrailMult = input.float(2.6, "ATR Trail Mult", minval = 0.1, step = 0.1)
showBg = input.bool(true, "Show Regime Background")
showLabels = input.bool(true, "Show State Labels")
showStop = input.bool(true, "Show ATR Stop")

kamaFunc(src, len, fastLen, slowLen) =>
    change = math.abs(src - nz(src[len], src))
    volatility = 0.0
    for i = 1 to len
        volatility += math.abs(nz(src[i - 1], src) - nz(src[i], src))
    er = volatility == 0.0 ? 0.0 : change / volatility
    fastSC = 2.0 / (fastLen + 1.0)
    slowSC = 2.0 / (slowLen + 1.0)
    sc = math.pow(er * (fastSC - slowSC) + slowSC, 2.0)
    kama = 0.0
    kama := na(kama[1]) ? src : kama[1] + sc * (src - kama[1])
    kama

kamaLine = kamaFunc(close, kamaLen, kamaFast, kamaSlow)
cciValue = ta.cci(hlc3, cciLen)
atrValue = ta.atr(atrLen)

coreWeight = coreWeightPct / 100.0
sleeveStrong = sleeveStrongPct / 100.0
sleeveNeutral = sleeveNeutralPct / 100.0
sleeveBad = sleeveBadPct / 100.0

strongRegime = close > kamaLine and kamaLine > kamaLine[1] and cciValue > cciThreshold
neutralRegime = close > kamaLine and not strongRegime

rawSleeveTarget = strongRegime ? sleeveStrong : neutralRegime ? sleeveNeutral : sleeveBad

var float sleeveEntry = na
var float highestClose = na
var float activeStop = na

sleeveIsActive = rawSleeveTarget > sleeveBad
sleeveWasActive = nz(rawSleeveTarget[1], sleeveBad) > sleeveBad

if sleeveIsActive and not sleeveWasActive
    sleeveEntry := close
    highestClose := close
    activeStop := close - atrValue * atrStopMult
else if sleeveIsActive
    highestClose := math.max(nz(highestClose, close), close)
    baseStop = nz(sleeveEntry, close) - atrValue * atrStopMult
    trailStop = highestClose - atrValue * atrTrailMult
    activeStop := math.max(nz(activeStop, baseStop), math.max(baseStop, trailStop))
else
    sleeveEntry := na
    highestClose := na
    activeStop := na

stopTriggered = sleeveIsActive and not na(activeStop) and close <= activeStop
finalSleeveTarget = stopTriggered ? sleeveBad : rawSleeveTarget
targetExposure = coreWeight + (1.0 - coreWeight) * finalSleeveTarget
targetExposurePct = targetExposure * 100.0
sleeveTargetPct = finalSleeveTarget * 100.0

state =
     stopTriggered ? "CORE ONLY"
     : strongRegime ? "STRONG"
     : neutralRegime ? "NEUTRAL"
     : "DEFENSIVE"

prevState = bar_index > 0 ? state[1] : state
stateChanged = state != prevState

plot(kamaLine, "KAMA", color = color.orange, linewidth = 2)
plot(showStop ? activeStop : na, "Sleeve ATR Stop", color = color.new(color.red, 0), linewidth = 1, style = plot.style_linebr)

bgcolor(
     showBg
         ? state == "STRONG" ? color.new(color.green, 88)
         : state == "NEUTRAL" ? color.new(color.yellow, 90)
         : color.new(color.red, 92)
         : na
)

plotshape(stateChanged and showLabels and state == "STRONG", title = "Strong", style = shape.labelup, location = location.belowbar, color = color.lime, textcolor = color.black, text = "STRONG")
plotshape(stateChanged and showLabels and state == "NEUTRAL", title = "Neutral", style = shape.labelup, location = location.belowbar, color = color.yellow, textcolor = color.black, text = "NEUTRAL")
plotshape(stateChanged and showLabels and state == "DEFENSIVE", title = "Defensive", style = shape.labeldown, location = location.abovebar, color = color.orange, textcolor = color.black, text = "DEF")
plotshape(stateChanged and showLabels and state == "CORE ONLY", title = "Core Only", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, text = "CORE")

var label infoLabel = na
if barstate.islast
    label.delete(infoLabel)
    infoText = "State: " + state + "\nSleeve: " + str.tostring(sleeveTargetPct, "#.##") + "%\nTotal: " + str.tostring(targetExposurePct, "#.##") + "%"
    infoLabel := label.new(bar_index, high, infoText, style = label.style_label_left, textcolor = color.white, color = color.new(color.black, 20))

alertcondition(stateChanged and state == "STRONG", title = "Strong Regime", message = "EGX30 ETF sleeve state changed to STRONG. Sleeve target 100%, total target 100%.")
alertcondition(stateChanged and state == "NEUTRAL", title = "Neutral Regime", message = "EGX30 ETF sleeve state changed to NEUTRAL. Sleeve target 60%, total target 92%.")
alertcondition(stateChanged and state == "DEFENSIVE", title = "Defensive Regime", message = "EGX30 ETF sleeve state changed to DEFENSIVE. Sleeve target 20%, total target 84%.")
alertcondition(stateChanged and state == "CORE ONLY", title = "Core Only", message = "EGX30 ETF sleeve ATR stop triggered. Drop to core allocation only.")
alertcondition(stateChanged, title = "Any Regime Change", message = "EGX30 ETF sleeve regime changed. Check target exposure on chart.")
