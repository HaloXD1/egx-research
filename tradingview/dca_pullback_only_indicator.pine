// EGX30 ETF DCA Pullback-Only Indicator
//@version=6
indicator("EGX30 ETF DCA Pullback-Only Indicator", overlay = true, max_labels_count = 500)

kamaLen = input.int(26, "KAMA Length", minval = 2)
kamaFast = input.int(3, "KAMA Fast", minval = 1)
kamaSlow = input.int(52, "KAMA Slow", minval = 2)
cciLen = input.int(26, "CCI Length", minval = 2)
buyThreshold = input.float(-45.0, "Buy Threshold", step = 1)
trendBufferAtr = input.float(1.7, "Trend Buffer ATR", minval = 0, step = 0.1)
atrLen = input.int(8, "ATR Length", minval = 1)
showBg = input.bool(true, "Show Regime Background")
showLabels = input.bool(true, "Show State Labels")
showBuffer = input.bool(true, "Show Trend Buffer")

kamaFunc(src, len, fastLen, slowLen) =>
    change = math.abs(src - nz(src[len], src))
    volatility = 0.0
    for i = 1 to len
        volatility += math.abs(nz(src[i - 1], src) - nz(src[i], src))
    er = volatility == 0.0 ? 0.0 : change / volatility
    fastSC = 2.0 / (fastLen + 1.0)
    slowSC = 2.0 / (slowLen + 1.0)
    sc = math.pow(er * (fastSC - slowSC) + slowSC, 2.0)
    kama = 0.0
    kama := na(kama[1]) ? src : kama[1] + sc * (src - kama[1])
    kama

kamaLine = kamaFunc(close, kamaLen, kamaFast, kamaSlow)
cciValue = ta.cci(hlc3, cciLen)
atrValue = ta.atr(atrLen)
bufferLine = kamaLine - atrValue * trendBufferAtr

trendIntact = close > bufferLine
buyZone = trendIntact and cciValue <= buyThreshold

state = buyZone ? "BUY ZONE" : trendIntact ? "WAIT" : "TREND BROKEN"
prevState = bar_index > 0 ? state[1] : state
stateChanged = state != prevState

plot(kamaLine, "KAMA", color = color.orange, linewidth = 2)
plot(showBuffer ? bufferLine : na, "Trend Buffer", color = color.new(color.red, 20), linewidth = 1)

bgcolor(
     showBg
         ? state == "BUY ZONE" ? color.new(color.green, 88)
         : state == "WAIT" ? color.new(color.yellow, 90)
         : color.new(color.red, 92)
         : na
)

plotshape(stateChanged and showLabels and state == "BUY ZONE", title = "Buy Zone", style = shape.labelup, location = location.belowbar, color = color.lime, textcolor = color.black, text = "BUY")
plotshape(stateChanged and showLabels and state == "WAIT", title = "Wait", style = shape.labelup, location = location.belowbar, color = color.yellow, textcolor = color.black, text = "WAIT")
plotshape(stateChanged and showLabels and state == "TREND BROKEN", title = "Trend Broken", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, text = "BROKEN")

var label infoLabel = na
if barstate.islast
    label.delete(infoLabel)
    infoText = "State: " + state + "\nAction: " + (state == "BUY ZONE" ? "Deploy waiting cash" : "Keep cash waiting")
    infoLabel := label.new(bar_index, high, infoText, style = label.style_label_left, textcolor = color.white, color = color.new(color.black, 20))

alertcondition(stateChanged and state == "BUY ZONE", title = "Enter Buy Zone", message = "EGX30 ETF pullback-only model entered BUY ZONE. Deploy waiting DCA cash.")
alertcondition(stateChanged and state == "WAIT", title = "Exit Buy Zone", message = "EGX30 ETF pullback-only model left BUY ZONE. Keep new cash waiting.")
alertcondition(stateChanged and state == "TREND BROKEN", title = "Trend Broken", message = "EGX30 ETF pullback-only model trend is broken. Keep cash waiting.")
alertcondition(stateChanged, title = "Any State Change", message = "EGX30 ETF pullback-only model changed state.")
