// BTC Donchian Breakout Strategy
//@version=6
strategy(
     "BTC Donchian Breakout Strategy",
     overlay = true,
     initial_capital = 100000,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.10,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 95,
     process_orders_on_close = false,
     calc_on_order_fills = true
)

entryLookback = input.int(109, "Entry Lookback", minval = 2)
exitLookback = input.int(88, "Exit Lookback", minval = 2)
regimeMa = input.int(110, "Regime SMA", minval = 1)
atrLen = input.int(10, "ATR Length", minval = 1)
atrStopMult = input.float(3.9, "ATR Stop Mult", minval = 0.1, step = 0.1)
atrTrailMult = input.float(4.6, "ATR Trail Mult", minval = 0.1, step = 0.1)
executionMode = input.string("Clean Alert", "Execution Mode", options = ["Clean Alert", "Backtest Match"])
positionSizePct = input.float(95.0, "Backtest Match Position %", minval = 1, maxval = 100, step = 1)
showBg = input.bool(true, "Show Regime Background")
showSignals = input.bool(false, "Show Extra Signal Shapes")

matchMode = executionMode == "Backtest Match"

plot(close, "Compiler Anchor", display = display.none)

roundQty(value) =>
    math.floor(value * 100000000.0) / 100000000.0

entryChannel = ta.highest(high, entryLookback)[1]
exitChannel = ta.lowest(low, exitLookback)[1]
regimeLine = ta.sma(close, regimeMa)

entrySignal = close > entryChannel and close > regimeLine
exitSignal = close < exitChannel or close < regimeLine

var float modelTarget = 0.0
var bool stoppedOut = false
if exitSignal
    modelTarget := 0.0
    stoppedOut := false
if entrySignal and not stoppedOut
    modelTarget := 1.0

atrValue = ta.atr(atrLen)
var float entryClose = na
var float highestClose = na
var float activeStop = na

if modelTarget > 0 and nz(modelTarget[1], 0) == 0
    entryClose := close
    highestClose := close
    activeStop := close - atrValue * atrStopMult
else if modelTarget > 0
    highestClose := math.max(nz(highestClose, close), close)
    baseStop = nz(entryClose, close) - atrValue * atrStopMult
    trailStop = highestClose - atrValue * atrTrailMult
    activeStop := math.max(nz(activeStop, baseStop), math.max(baseStop, trailStop))
else
    entryClose := na
    highestClose := na
    activeStop := na

stopTriggered = modelTarget > 0 and not na(activeStop) and close <= activeStop
if stopTriggered
    stoppedOut := true
    modelTarget := 0.0

targetExposure = modelTarget
buySignal = targetExposure > 0 and nz(targetExposure[1], 0) <= 0
sellSignal = targetExposure <= 0 and nz(targetExposure[1], 0) > 0
signalCode = stopTriggered ? -2.0 : buySignal ? 1.0 : sellSignal ? -1.0 : 0.0

plot(targetExposure, "egx_target_exposure", display = display.data_window)
plot(signalCode, "egx_signal_code", display = display.data_window)
matchQty = roundQty(strategy.equity * (positionSizePct / 100.0) * targetExposure / close)
matchDelta = matchQty - strategy.position_size

if barstate.isconfirmed
    if matchMode
        if matchDelta > 0
            strategy.order("match_up", strategy.long, qty = matchDelta, comment = "MATCH BUY")
        else if matchDelta < 0
            strategy.order("match_down", strategy.short, qty = math.abs(matchDelta), comment = "MATCH SELL")
    else if buySignal
        strategy.entry("Long", strategy.long, comment = "BUY")
    else if sellSignal
        strategy.close("Long", comment = "SELL")

plot(entryChannel, "Entry Channel", color = color.new(color.green, 0), linewidth = 1)
plot(exitChannel, "Exit Channel", color = color.new(color.red, 0), linewidth = 1)
plot(regimeLine, "Regime SMA", color = color.orange, linewidth = 2)
plot(activeStop, "ATR Stop", color = color.new(color.red, 0), linewidth = 1, style = plot.style_linebr)

bgcolor(showBg ? targetExposure > 0 ? color.new(color.green, 88) : color.new(color.red, 92) : na)

plotshape(showSignals and buySignal, title = "Buy", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny, text = "BUY")
plotshape(showSignals and sellSignal, title = "Sell", style = shape.triangledown, location = location.abovebar, color = color.orange, size = size.tiny, text = "SELL")

plotchar(targetExposure * 100.0, title = "Target Exposure %", char = "", location = location.top)

alertcondition(buySignal, "BTC Donchian Buy", "BTC Donchian Breakout target increased to 100%.")
alertcondition(sellSignal, "BTC Donchian Sell", "BTC Donchian Breakout target reduced to 0%.")
alertcondition(stopTriggered, "BTC Donchian ATR Stop", "BTC Donchian Breakout ATR stop triggered.")

if stopTriggered
    alert('{"strategy":"crypto_donchian_breakout","action":"stop","ticker":"' + syminfo.tickerid + '","target_exposure":' + str.tostring(targetExposure) + ',"price":' + str.tostring(close) + '}', alert.freq_once_per_bar_close)
else if buySignal
    alert('{"strategy":"crypto_donchian_breakout","action":"buy","ticker":"' + syminfo.tickerid + '","target_exposure":' + str.tostring(targetExposure) + ',"price":' + str.tostring(close) + '}', alert.freq_once_per_bar_close)
else if sellSignal
    alert('{"strategy":"crypto_donchian_breakout","action":"sell","ticker":"' + syminfo.tickerid + '","target_exposure":' + str.tostring(targetExposure) + ',"price":' + str.tostring(close) + '}', alert.freq_once_per_bar_close)
