{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egx-research.local/schemas/tradingview-symbols.json",
  "type": "object",
  "required": ["symbols"],
  "properties": {
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["logical_symbol", "local_path", "asset_class", "timeframe", "timezone"],
        "properties": {
          "logical_symbol": {"type": "string", "minLength": 1},
          "local_path": {"type": "string", "minLength": 1},
          "tradingview_symbol": {"type": "string"},
          "asset_class": {"enum": ["equity", "crypto", "index", "fund", "forex", "futures"]},
          "timeframe": {"type": "string"},
          "timezone": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
